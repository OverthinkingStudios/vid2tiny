<Window x:Class="Vid2Tiny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:Vid2Tiny.Services"
        mc:Ignorable="d"
        Title="{x:Static services:AppInfo.Title}" Closing="Window_Closing" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown"
        Width="1920"
        Height="1000"
        MinWidth="1200"
        MinHeight="760"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="420" />
            <RowDefinition Height="12" />
            <RowDefinition Height="150" MinHeight="70" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="640" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Content="{Binding Preview}" Focusable="False" />

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <ContentControl Content="{Binding EncodeOptions}" Focusable="False" />
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="Export" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource ToolButton}"
                                                AutomationProperties.Name="Open output folder in Explorer"
                                                Command="{Binding OpenOutputFolderCommand}"
                                                ToolTip="Open in Explorer">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                                        </Button>
                                        <Button DockPanel.Dock="Right"
                                                Margin="4,0,0,0"
                                                Command="{Binding BrowseOutputFolderCommand}"
                                                Content="Browse…" />
                                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="File name" />
                                    <TextBox AutomationProperties.Name="File name" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right"
                                        Padding="20,7"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding ConvertCommand}"
                                        Content="Convert clip" />
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="{Binding ExportStatus}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Margin="0,6,0,0"
                                                 IsIndeterminate="{Binding IsBusy}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <TabControl Grid.Column="2">
                <TabItem Header="Source videos">
                    <ContentControl Content="{Binding SourceGallery}" Focusable="False" />
                </TabItem>
                <TabItem Header="Output clips">
                    <ContentControl Content="{Binding OutputGallery}" Focusable="False" />
                </TabItem>
            </TabControl>
        </Grid>

        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" />

        <ContentControl Grid.Row="2" Content="{Binding Log}" Focusable="False" />
    </Grid>
</Window>
