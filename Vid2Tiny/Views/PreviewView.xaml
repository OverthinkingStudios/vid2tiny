<UserControl x:Class="Vid2Tiny.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="8"
                Background="#202020"
                BorderBrush="#505050"
                BorderThickness="1"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop">
            <Grid>
                <MediaElement x:Name="VideoPlayer"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              Stretch="Uniform"
                              Loaded="OnVideoPlayerLoaded"
                              Unloaded="OnVideoPlayerUnloaded"
                              MediaOpened="OnMediaOpened"
                              MediaEnded="OnMediaEnded"
                              ScrubbingEnabled="True" />
                <Canvas x:Name="OverlayCanvas"
                        Background="#01000000"
                        MouseLeftButtonDown="OnOverlayMouseLeftButtonDown"
                        MouseMove="OnOverlayMouseMove"
                        MouseLeftButtonUp="OnOverlayMouseLeftButtonUp"
                        SizeChanged="OnOverlaySizeChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    Content="Play/Pause"
                    Command="{Binding TogglePlayPauseCommand}" />
            <Button Grid.Column="1"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    Content="-5s"
                    Command="{Binding StepBackCommand}" />
            <Button Grid.Column="2"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    Content="+5s"
                    Command="{Binding StepForwardCommand}" />
            <Button Grid.Column="3"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    Content="Set Start"
                    Command="{Binding MarkStartCommand}" />
            <Button Grid.Column="4"
                    HorizontalAlignment="Left"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    Content="Set End"
                    Command="{Binding MarkEndCommand}" />
            <TextBlock Grid.Column="5"
                       VerticalAlignment="Center"
                       Text="{Binding LoadedFilePath}" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="SliderContainer" SizeChanged="OnSliderContainerSizeChanged">
                <Slider x:Name="SeekSlider"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ValueChanged="OnSeekValueChanged" />
                <Canvas x:Name="TimelineMarkersCanvas" IsHitTestVisible="False" VerticalAlignment="Stretch" Height="24" Margin="0,-12,0,0" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,2,8,0"
                           Text="{Binding StartSeconds, StringFormat=Start: {0:F1}s}" />
                <TextBlock Grid.Column="1"
                           Margin="0,2,8,0"
                           Text="{Binding PositionSeconds, StringFormat=Now: {0:F1}s}" />
                <TextBlock Grid.Column="2"
                           Margin="0,2,8,0"
                           Text="{Binding EndSeconds, StringFormat=End: {0:F1}s}" />
                <TextBlock Grid.Column="4"
                           Margin="0,2,0,0"
                           Text="Drop video file here" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
