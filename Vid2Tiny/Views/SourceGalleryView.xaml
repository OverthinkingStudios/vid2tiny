<UserControl x:Class="Vid2Tiny.Views.SourceGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Vid2Tiny.Views"
             xmlns:viewModels="clr-namespace:Vid2Tiny.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="420"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <ToggleButton DockPanel.Dock="Right"
                          Style="{StaticResource ToolButton}"
                          IsChecked="{Binding IsFolderPanelOpen}"
                          ToolTip="Choose which folders to scan for recordings">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                    <TextBlock Margin="6,0,0,0" Text="Folders" />
                </StackPanel>
            </ToggleButton>
            <Button DockPanel.Dock="Right"
                    Margin="0,0,4,0"
                    Style="{StaticResource ToolButton}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Rescan folders (F5)">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
            </Button>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource Caption}"
                       Text="{Binding Summary}" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="10,8"
                Background="{StaticResource Brush.Subtle}"
                CornerRadius="6"
                Visibility="{Binding IsFolderPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding SourceFolders}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right"
                                        Padding="6"
                                        Style="{StaticResource ToolButton}"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Stop scanning this folder">
                                    <TextBlock FontSize="10" Style="{StaticResource Icon}" Text="&#xE8BB;" />
                                </Button>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,6,0,0">
                    <Button Command="{Binding BrowseFoldersCommand}" Content="Add folder…" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Caption}"
                               Text="Each subfolder becomes a tag. The output folder is always skipped."
                               TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right"
                    Margin="6,4,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource LinkButton}"
                    Command="{Binding ShowAllTagsCommand}"
                    Content="Show all"
                    Visibility="{Binding HasHiddenTags, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource TagChip}"
                                  IsChecked="{Binding IsVisible}"
                                  AutomationProperties.Name="{Binding Name}"
                                  ToolTip="Click to show or hide. Right-click to show only this one.">
                            <CheckBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ShowOnlyCommand}">
                                        <MenuItem.Header>
                                            <TextBlock Text="{Binding Name, StringFormat=Show only {0}}" />
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Header="Show all" Command="{Binding ShowAllCommand}" />
                                </ContextMenu>
                            </CheckBox.ContextMenu>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <ItemsControl Grid.Row="3"
                      Margin="0,4,0,0"
                      Style="{StaticResource GalleryList}"
                      ItemsSource="{Binding Videos}">
            <ItemsControl.GroupStyle>
                <StaticResource ResourceKey="DayGroupStyle" />
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:SourceVideoViewModel}">
                    <Border Background="{Binding Tag.Tint}" Style="{StaticResource GalleryRow}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding OpenInEditorCommand}" Gesture="LeftDoubleClick" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding Tag.Accent}" CornerRadius="4,0,0,4" />
                            <views:VideoThumbnail Grid.Column="1"
                                                  Width="128"
                                                  Height="72"
                                                  Margin="6"
                                                  FilePath="{Binding FilePath}"
                                                  Stamp="{Binding LastWriteTimeUtc}" />
                            <StackPanel Grid.Column="2"
                                        Margin="4,6,10,6"
                                        VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding SizeText}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TimeText}"
                                                   ToolTip="{Binding TimestampText}" />
                                        <Border Style="{StaticResource OpenBadge}">
                                            <TextBlock Text="In editor" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Tag.Accent}"
                                           Text="{Binding Tag.Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3">
            <StackPanel.Style>
                <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyState}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:SourceGalleryState.NoFolders}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource EmptyTitle}" Text="Where do your recordings live?" />
            <TextBlock Style="{StaticResource EmptyBody}"
                       Text="Add the folder your recorder saves to, or drop it here. Each subfolder, like one per game, becomes a tag." />
            <Button HorizontalAlignment="Center"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding BrowseFoldersCommand}"
                    Content="Add folder…" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <StackPanel.Style>
                <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyState}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:SourceGalleryState.NoVideos}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource EmptyTitle}" Text="No videos found" />
            <TextBlock Style="{StaticResource EmptyBody}"
                       Text="New recordings in your source folders show up here as soon as they are saved." />
            <Button HorizontalAlignment="Center"
                    Command="{Binding BrowseFoldersCommand}"
                    Content="Add folder…" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <StackPanel.Style>
                <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyState}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:SourceGalleryState.AllHidden}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource EmptyTitle}" Text="Every tag is hidden" />
            <TextBlock Style="{StaticResource EmptyBody}" Text="Turn a tag back on above to see its videos." />
            <Button HorizontalAlignment="Center"
                    Command="{Binding ShowAllTagsCommand}"
                    Content="Show all" />
        </StackPanel>
    </Grid>
</UserControl>
