<UserControl x:Class="Vid2Tiny.Views.EncodeOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="260"
             d:DesignWidth="640">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <Style x:Key="SimpleOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Advanced}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AdvancedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Advanced}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,12">
            <CheckBox DockPanel.Dock="Right"
                      Content="Advanced"
                      IsChecked="{Binding Advanced}"
                      ToolTip="Show the individual ffmpeg options instead of a single quality slider" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="Encoding" />
        </DockPanel>

        <StackPanel Style="{StaticResource SimpleOnly}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Quality" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Text="Smaller" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Text="Better" />
                <Slider LargeChange="0.1"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.02"
                        Value="{Binding Quality}" />
            </DockPanel>
            <CheckBox Margin="0,12,0,0"
                      Content="Mute audio"
                      IsChecked="{Binding MuteAudio}" />
        </StackPanel>

        <Grid Style="{StaticResource AdvancedOnly}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Video" />
                <ComboBox ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding Codecs}"
                          SelectedValue="{Binding Codec}"
                          SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Column="2" IsEnabled="{Binding IsReencoding}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Speed (slower = smaller)" />
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" />
            </StackPanel>

            <StackPanel Grid.Row="2" IsEnabled="{Binding IsReencoding}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Rate control" />
                <ComboBox ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding RateControls}"
                          SelectedValue="{Binding RateControl}"
                          SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Grid.Column="2"
                        Visibility="{Binding IsConstantQuality, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Crf, StringFormat=CRF {0}}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Quality (lower = better)" />
                </DockPanel>
                <Slider IsSnapToTickEnabled="True"
                        Maximum="40"
                        Minimum="14"
                        TickFrequency="1"
                        Value="{Binding Crf}" />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Grid.Column="2"
                        Visibility="{Binding IsTargetSize, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Target size" />
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Command="{Binding FitTargetSizeCommand}"
                            Content="10 MB"
                            ToolTip="Set the target to Discord's 10 MB upload limit" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="MB" />
                    <TextBox Text="{Binding TargetMegabytes, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" IsEnabled="{Binding IsReencoding}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Max resolution" />
                <ComboBox ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding Heights}"
                          SelectedValue="{Binding MaxHeight}"
                          SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" IsEnabled="{Binding IsReencoding}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Max frame rate" />
                <ComboBox ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding FrameRates}"
                          SelectedValue="{Binding MaxFrameRate}"
                          SelectedValuePath="Value" />
            </StackPanel>

            <StackPanel Grid.Row="6">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Audio" />
                <ComboBox IsEnabled="{Binding MuteAudio, Converter={StaticResource InverseBool}}"
                          ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding AudioBitrates}"
                          SelectedValue="{Binding AudioKbps}"
                          SelectedValuePath="Value" />
            </StackPanel>
            <CheckBox Grid.Row="6"
                      Grid.Column="2"
                      Margin="0,0,0,6"
                      VerticalAlignment="Bottom"
                      Content="Mute audio"
                      IsChecked="{Binding MuteAudio}" />
        </Grid>

        <TextBlock Margin="0,10,0,0"
                   Style="{StaticResource Caption}"
                   Text="{Binding Hint}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" />

        <Border Margin="0,14,0,0"
                Padding="12,8"
                Background="{StaticResource Brush.Subtle}"
                CornerRadius="6">
            <StackPanel>
                <DockPanel>
                    <ContentControl DockPanel.Dock="Right" Focusable="False" Style="{StaticResource SimpleOnly}">
                        <ToggleButton AutomationProperties.Name="Fit under 10 MB"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding FitToLimit}"
                                      Style="{StaticResource ToolButton}">
                            <ToggleButton.ToolTip>
                                <StackPanel MaxWidth="300">
                                    <TextBlock FontWeight="SemiBold" Text="Fit under 10 MB" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Picks the best quality that stays below Discord's 10 MB upload limit, and keeps it fitted while you change the clip. Moving the slider turns it off."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ToggleButton.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73F;" />
                                <TextBlock Margin="6,0,0,0" Text="Fit under 10 MB" />
                            </StackPanel>
                        </ToggleButton>
                    </ContentControl>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding SizeText}" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding Details}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,6,0,0" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Margin="0,1,8,0"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource Brush.Warning}"
                               Style="{StaticResource Icon}"
                               Text="&#xE7BA;" />
                    <TextBlock Foreground="{StaticResource Brush.Warning}"
                               Text="{Binding Warning}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
